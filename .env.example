# Copy to .env and fill in. .env is git-ignored. Never commit real keys.
# IBM Cloud API key: cloud.ibm.com → Manage → Access (IAM) → API keys → Create
WATSONX_APIKEY=
# watsonx.ai Studio → HospitalFlow AI project → Manage → General → Project ID
WATSONX_PROJECT_ID=
# Region of your watsonx.ai Runtime (Dallas shown). Others: eu-de, eu-gb, jp-tok, au-syd, ca-tor
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Granite 4 (us-south / eu-de). Alternative in all regions: meta-llama/llama-3-3-70b-instruct
WATSONX_MODEL_ID=ibm/granite-4-h-small
# Set to false to force rule-based mode (e.g. offline demo)
WATSONX_ENABLED=true
